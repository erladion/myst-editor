{
  "name": "mysteditor",
  "productName": "MyST Editor",
  "version": "0.3.0",
  "description": "WYSIWYG editor for Sphinx + MyST Markdown",
  "author": "erladion",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "typecheck": "tsc -p .",
    "roundtrip": "tsx scripts/roundtrip-report.ts",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "node scripts/fetch-uv.mjs && electron-vite build && electron-builder --linux AppImage rpm deb --publish never",
    "test:sphinx": "vitest run --config vitest.integration.config.ts",
    "fetch-uv": "node scripts/fetch-uv.mjs",
    "dist:win": "node scripts/fetch-uv.mjs --platform win32 && electron-vite build && electron-builder --win nsis --publish never",
    "dist:appimage": "node scripts/fetch-uv.mjs && electron-vite build && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "diff": "^9.0.0",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "katex": "0.19.0",
    "myst-parser": "^1.7.4",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.6",
    "punycode": "2.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "smol-toml": "1.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "7.3.7",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "desktopName": "mysteditor.desktop",
  "homepage": "https://github.com/erladion/myst-editor"
}
